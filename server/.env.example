# ========================================================
# WORKROOM BACKEND CONFIGURATION
# ========================================================

PORT=5001
NODE_ENV=development

# Render PostgreSQL Database Connection String:
# Example: postgres://workroom_user:secret_password@dpg-xxx-a.oregon-postgres.render.com:5432/workroom_db
DATABASE_URL=

# SSL config (set to true for Render or leave empty for auto-detect)
DB_SSL=true

# JWT Authentication Secret
JWT_SECRET=workroom_super_secure_enterprise_key_2026_change_me

# Default Admin Credentials (Seeded on first database startup)
DEFAULT_ADMIN_NAME="Workroom Lead Admin"
DEFAULT_ADMIN_EMAIL="admin@workroom.io"
DEFAULT_ADMIN_PASSWORD="Admin@123"

# Admin Registration Protection Secret (Required when registering an admin account)
ADMIN_SIGNUP_SECRET="workroom_admin_2026"

# Cloudinary Storage Configuration (For Invoices, Technical Docs, QR codes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
