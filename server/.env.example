# ========================================================
# WORKROOM BACKEND CONFIGURATION
# ========================================================

PORT=5001
NODE_ENV=development
CLIENT_URL=https://workroom-status.vercel.app

# Neon PostgreSQL Database Connection String:
# Example: postgresql://workroom_owner:npg_secret@ep-cool-fog-123456.us-east-2.aws.neon.tech/workroom?sslmode=require
DATABASE_URL=

# SSL config (Neon requires SSL; leave true)
DB_SSL=true

# JWT Authentication Secret
JWT_SECRET=workroom_super_secure_enterprise_key_2026_change_me

# Default Admin Credentials (Seeded on first database startup)
DEFAULT_ADMIN_NAME="Workroom Lead Admin"
DEFAULT_ADMIN_EMAIL="admin@workroom.io"
DEFAULT_ADMIN_PASSWORD="Admin@123"

# Admin Registration Protection Secret
ADMIN_SIGNUP_SECRET="workroom_admin_2026"

# Cloudinary Storage Configuration (Optional: fallback to local uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
